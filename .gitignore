# OS / editor noise
.DS_Store
Thumbs.db
desktop.ini
*.swp
.idea/
.vscode/

# Local agent/session state — not part of the project
.claude/

# Backups produced while editing
*.bak
index.html.bak

# A vault living inside the repo folder is the user's own notes, not code.
# Adjust if you deliberately want to ship an example vault.
ELM_Data/
ELM_data/
vault/

# Scratch output from publishing/exporting locally
elm-site.zip
elm-site-extracted/

# Test tooling (dev-only, never shipped — see package.json)
node_modules/
test-results/
playwright-report/
# Regenerated at test-time by tests/e2e/*.spec.js's own beforeAll hooks —
# not static assets, no need to commit them.
tests/e2e/fixtures/
